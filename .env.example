# Legacy FastAPI/Compose reference only. The Flutter app uses Supabase; do not
# deploy this stack as the production backend. Keep values below as placeholders.
POSTGRES_DB=armoury
# Verified email allowlisted for sole-admin bootstrap, only before any admin exists.
ARMOURY_BOOTSTRAP_ADMIN_EMAIL=aritraghosh.ag2005@gmail.com
POSTGRES_ADMIN_USER=armoury_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ARMOURY_APP_USER=armoury_app
ARMOURY_APP_PASSWORD=replace-with-a-long-random-app-password

# Set this to the DNS name pointing to the server for automatic HTTPS.
PUBLIC_HOST=localhost

# Supabase email confirmation uses a numeric OTP. Local messages are captured
# by Mailpit; configure a custom SMTP provider in the hosted Supabase project.
